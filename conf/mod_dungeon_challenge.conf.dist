###############################################################################
# mod-dungeon-challenge Configuration
###############################################################################

[worldserver]

###############################################################################
# DUNGEON CHALLENGE MODULE
#
#   DungeonChallenge.Enable
#       Enable/Disable the module
#       Default: 1 (enabled)
#
#   DungeonChallenge.AffixPercentage
#       Percentage of mobs in a dungeon that receive ALL available affixes
#       Default: 10
#
#   DungeonChallenge.MaxDifficulty
#       Maximum difficulty level players can select (100 levels, +1 affix every 10 levels)
#       Default: 100
#
#   DungeonChallenge.HealthMultiplierPerLevel
#       Health multiplier added per difficulty level (percentage)
#       e.g., 15 means +15% health per level -> Level 10 = +150%
#       Default: 15
#
#   DungeonChallenge.DamageMultiplierPerLevel
#       Damage multiplier added per difficulty level (percentage)
#       Applied via UnitScript hooks (ModifyMeleeDamage, ModifySpellDamageTaken)
#       e.g., 8 means +8% damage per level -> Level 10 = +80%
#       Default: 8
#
#   DungeonChallenge.TimerBaseMinutes
#       Base timer in minutes (adjusted per dungeon via DB)
#       Default: 30
#
#   DungeonChallenge.LootBonusPerLevel
#       Extra gold reward per difficulty level in copper
#       Default: 50000 (5 gold)
#
#
#   DungeonChallenge.AnnounceOnLogin
#       Announce module on player login
#       Default: 1
#
#   DungeonChallenge.DeathPenaltySeconds
#       Time penalty added per player death (in seconds)
#       Default: 15
#
#   DungeonChallenge.GameObjectEntry
#       Entry ID for the Dungeon Challenge Stone (GameObject)
#       This is the clickable object that opens the Lua gossip UI.
#       Default: 500002
#
#   DungeonChallenge.ParagonXPPerLevel
#       Paragon XP reward per difficulty level on dungeon completion
#       Doubled if completed in time
#       Formula: ParagonXPPerLevel * difficulty * (inTime ? 2 : 1)
#       Example: Level 50 in time = 10 * 50 * 2 = 1000 Paragon XP
#       Default: 10
#
#   DungeonChallenge.SummarySeconds
#       Seconds the run-end summary stays open before the player is auto-teleported
#       to their hearthstone/home. A "Leave" button on the summary exits earlier.
#       NOTE: mirror this value in the Lua CONFIG.SUMMARY_SECONDS.
#       Default: 30
#
#   DungeonChallenge.DeathEndsRunMode
#       When a player death ends the run: 0 = only on a WIPE (all participants
#       dead; solo death always ends), 1 = on ANY single death.
#       NOTE: mirror this value in the Lua CONFIG.DEATH_ENDS_RUN.
#       Default: 0
#
#   DungeonChallenge.FallbackSeconds
#       Safety net (seconds): if the client addon/Lua is unavailable, the server
#       teleports any still-present player home and resets the run after this long.
#       Should be greater than SummarySeconds.
#       Default: 40
#

DungeonChallenge.Enable = 1
DungeonChallenge.AffixPercentage = 15
DungeonChallenge.MaxDifficulty = 100
DungeonChallenge.HealthMultiplierPerLevel = 15
DungeonChallenge.DamageMultiplierPerLevel = 8
DungeonChallenge.TimerBaseMinutes = 30
DungeonChallenge.LootBonusPerLevel = 50000

DungeonChallenge.AnnounceOnLogin = 1
DungeonChallenge.DeathPenaltySeconds = 15
DungeonChallenge.GameObjectEntry = 500002
DungeonChallenge.ParagonXPPerLevel = 10

DungeonChallenge.SummarySeconds = 30
DungeonChallenge.DeathEndsRunMode = 0
DungeonChallenge.FallbackSeconds = 40
